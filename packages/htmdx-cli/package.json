{
  "name": "@wix/htmdx-cli",
  "version": "0.0.0",
  "private": true,
  "description": "Lint HTMDX artifacts and source files from the command line.",
  "keywords": [
    "agents",
    "artifacts",
    "cli",
    "htmdx",
    "lint"
  ],
  "license": "MIT",
  "author": "Vlad Tansky (https://github.com/vltansky)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wix-incubator/htmdx.git",
    "directory": "packages/htmdx-cli"
  },
  "bin": {
    "htmdx": "./dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lint.d.ts",
      "default": "./dist/lint.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@wix/htmdx": "workspace:^",
    "jsdom": "^27.2.0"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
